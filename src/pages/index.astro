---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompatibilityCard from '../components/CompatibilityCard.astro';
import { DOWNLOADS, FEATURES, SITE } from '../data/site';
---

<BaseLayout>
  <section class="pt-14 pb-12 sm:pt-20 sm:pb-16">
    <div class="mx-auto max-w-5xl px-5 sm:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <img
          src="/memos.png"
          alt="Moe Memos"
          width="68"
          height="68"
          class="mx-auto h-17 w-17 rounded-[18px] border border-[var(--border)]"
        />

        <h1 class="mt-6 text-3xl leading-tight font-semibold tracking-tight text-[var(--ink)] sm:text-5xl">
          Capture thoughts and ideas.
        </h1>

        <p class="mt-4 text-balance text-base leading-relaxed text-[var(--ink-muted)] sm:text-lg">
          Use locally on your device or sync with your self-hosted{' '}
          <a
            href={SITE.memosRepo}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-[var(--ink)] underline decoration-[var(--border-strong)] underline-offset-4 hover:decoration-[var(--ink)]"
          >
            Memos
          </a>{' '}
          server.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href={DOWNLOADS.appStore}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-[var(--ink)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition-opacity hover:opacity-90"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.33c.64-.78 1.08-1.86.96-2.94-.93.04-2.06.62-2.72 1.4-.58.68-1.1 1.78-.96 2.84 1.04.08 2.08-.52 2.72-1.3" />
            </svg>
            <span>App Store</span>
          </a>

          <a
            href={DOWNLOADS.googlePlay}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-[var(--border-strong)] bg-[var(--bg)] px-5 py-2.5 text-sm font-medium text-[var(--ink)] transition-colors hover:bg-[var(--surface-subtle)]"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.609 1.814 13.792 12 3.61 22.186a1.75 1.75 0 0 1-.61-1.33V3.144c0-.517.224-.997.609-1.33Zm11.24 11.242 2.668 2.668-11.09 6.322 8.422-8.99Zm3.702-2.11 2.238 1.276c.815.464.815 1.638 0 2.102l-2.238 1.276-2.963-2.327 2.963-2.327ZM6.427 1.954l11.09 6.322-2.668 2.668-8.422-8.99Z" />
            </svg>
            <span>Google Play</span>
          </a>

          <a
            href={DOWNLOADS.fDroid}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-[var(--border-strong)] bg-[var(--bg)] px-5 py-2.5 text-sm font-medium text-[var(--ink)] transition-colors hover:bg-[var(--surface-subtle)]"
          >
            <span>F-Droid</span>
          </a>
        </div>
      </div>

      <!-- Desktop: proportional flex row so iPhone, iPad, and Android share identical height -->
      <div class="mt-14 hidden items-stretch gap-5 md:flex">
        <div style="flex: 0.4615 1 0%;">
          <img
            src="/screenshots/ios-1.png"
            alt="Moe Memos on iPhone"
            width="600"
            height="1300"
            class="block h-auto w-full rounded-[22px] border border-[var(--border)] bg-[var(--surface)] shadow-sm"
          />
        </div>

        <div style="flex: 1.3333 1 0%;">
          <img
            src="/screenshots/ipad-1.png"
            alt="Moe Memos on iPad"
            width="1280"
            height="960"
            class="block h-auto w-full rounded-[18px] border border-[var(--border)] bg-[var(--surface)] shadow-sm"
          />
        </div>

        <div style="flex: 0.45 1 0%;">
          <img
            src="/screenshots/android-light.png"
            alt="Moe Memos on Android"
            width="1080"
            height="2400"
            class="block h-auto w-full rounded-[22px] border border-[var(--border)] bg-[var(--surface)] shadow-sm dark:hidden"
          />
          <img
            src="/screenshots/android-dark.png"
            alt="Moe Memos on Android in dark mode"
            width="1080"
            height="2400"
            class="hidden h-auto w-full rounded-[22px] border border-[var(--border)] bg-[var(--surface)] shadow-sm dark:block"
          />
        </div>
      </div>

      <!-- Mobile: iPad on top, iPhone and Android side by side at matching height -->
      <div class="mt-12 space-y-4 md:hidden">
        <img
          src="/screenshots/ipad-1.png"
          alt="Moe Memos on iPad"
          width="1280"
          height="960"
          class="block h-auto w-full rounded-[16px] border border-[var(--border)] bg-[var(--surface)] shadow-sm"
        />
        <div class="flex items-stretch gap-3">
          <div style="flex: 46.15 1 0%;">
            <img
              src="/screenshots/ios-1.png"
              alt="Moe Memos on iPhone"
              width="600"
              height="1300"
              class="block h-auto w-full rounded-[18px] border border-[var(--border)] bg-[var(--surface)] shadow-sm"
            />
          </div>
          <div style="flex: 45 1 0%;">
            <img
              src="/screenshots/android-light.png"
              alt="Moe Memos on Android"
              width="1080"
              height="2400"
              class="block h-auto w-full rounded-[18px] border border-[var(--border)] bg-[var(--surface)] shadow-sm dark:hidden"
            />
            <img
              src="/screenshots/android-dark.png"
              alt="Moe Memos on Android in dark mode"
              width="1080"
              height="2400"
              class="hidden h-auto w-full rounded-[18px] border border-[var(--border)] bg-[var(--surface)] shadow-sm dark:block"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {FEATURES.map((feature) => (
        <div>
          <h2 class="text-base font-semibold tracking-tight text-[var(--ink)]">
            {feature.title}
          </h2>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--ink-muted)]">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 sm:px-8">
    <CompatibilityCard />
  </section>
</BaseLayout>
