---
import { MEMOS_COMPATIBILITY, SITE } from '../data/site';
---

<div class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-base font-semibold tracking-tight text-[var(--ink)]">
      Supported Memos versions
    </h2>
    <div class="flex flex-wrap gap-2">
      {MEMOS_COMPATIBILITY.versions.map((version) => (
        <span class="rounded-md border border-[var(--border)] bg-[var(--bg)] px-2.5 py-0.5 font-mono text-xs text-[var(--ink)]">
          {version}
        </span>
      ))}
    </div>
  </div>

  <p class="mt-3 text-sm leading-relaxed text-[var(--ink-muted)]">
    Memos updates may introduce breaking API changes. For newer or unsupported versions, use{' '}
    <a
      href={SITE.mortisRepo}
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium text-[var(--ink)] underline decoration-[var(--border-strong)] underline-offset-4 hover:decoration-[var(--ink)]"
    >
      Mortis
    </a>{' '}
    to translate the API to Memos 0.21.0 and sign in again.
  </p>
</div>
